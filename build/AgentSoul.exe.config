<?xml version="1.0" encoding="utf-8"?>
<!--
  AgentSoul 壳的应用配置（2026-11-21）—— 与 AgentSoul.manifest 配套。

  ★ 为什么必须有这一份：
    AgentSoul.manifest 只管**进程**的 DPI 感知级别（解决「糊」）。
    但 .NET Framework 的 WinForms 在 4.7 之前**无条件按 96 DPI 排版**，
    即使进程已经是 PerMonitorV2 —— 结果会从「字糊」变成「窗口偏小、控件错位」。
    System.Windows.Forms.ApplicationConfigurationSection 是官方给的 opt-in 开关：
    开了它，WinForms 才会按当前显示器的 DPI 缩放控件、并在收到 WM_DPICHANGED 时重排。

  ★ 部署位置：必须叫 <exe 名>.config，与 exe **同目录**。build.ps1 会复制，
    tools/make-dist.mjs 把它一起打进 app/<版本> 与安装包。
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime>
    <!-- 长路径：与 manifest 的 longPathAware 一起用，缺一个都不生效 -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false"/>
  </runtime>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <!-- ★ 这一行是「WinForms 认不认 PerMonitorV2」的总闸 -->
    <add key="DpiAwareness" value="PerMonitorV2" />
    <!-- 控件默认字体按系统 UI 走，不要在 150% 上被二次放大 -->
    <add key="DisableDpiChangedMessageHandling" value="false" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
