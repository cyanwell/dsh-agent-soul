{
  "name": "dsh-agent-soul-bridge",
  "version": "0.1.10",
  "description": "agent-soul v4 控制通道的宿主端：连 ws://127.0.0.1:7310/control，自报能力、接 exec、回执、每轮上报上下文水位、断线指数退避重连。零第三方依赖。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./ws": "./ws.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "ws.js",
    "client.js",
    "bridge-proof.mjs",
    "process-inspector.mjs",
    "manager-proof-client.mjs",
    "lifecycle-inspect.mjs",
    "pruner-adapter.mjs",
    "context-surgeon.mjs",
    "probe.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "syntax": "node --check index.js && node --check ws.js && node --check probe.mjs && node --check pruner-adapter.mjs && node --check context-surgeon.mjs",
    "selftest": "node --test _verify/pruner-eval/pruner-stub.test.mjs _verify/pruner-eval/wire-refusal.test.mjs _verify/management-security.test.mjs",
    "packaging:smoke": "node _verify/packaging-smoke.mjs",
    "client:preflight": "node _verify/client-half-preflight.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "agent-soul",
    "control-channel",
    "websocket"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
