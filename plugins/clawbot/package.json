  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "REPORT.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "wechat",
    "微信",
    "clawbot",
    "ilink"
