{
  "name": "dsh-huanqi",
  "description": "换气 (huanqi) — 思考预算管理器。一轮把输出预算烧光、正文一个字没出来时，截断这一轮并再开一轮（最多 N 次）；接不动了就熔断，塞一段能认出来的话请人介入。额度是体温计不是配额：靠正常对话慢慢攒，异常时下降，最低 1 点。★ 延续额度 N 等参数在 profiles\\<profile>\\cordis.patch.yml 里调（搜 id: huanqi），改完重启生效。吸收 dsh-loop-guard 的重复检测与 dsh-reasoning-only-guard 的空消息保护。",
  "version": "1.2.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./tools/*": "./tools/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "src/**/*.ts",
    "tools/analyze-session.mjs",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "huanqi",
    "换气",
    "thinking-budget",
    "continuation",
    "circuit-breaker",
    "guard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.7-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.7-rc.1",
    "semver": "^7.8.5",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "test": "node --test \"test/*.spec.mjs\"",
    "analyze": "node tools/analyze-session.mjs"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    }
  }
}
