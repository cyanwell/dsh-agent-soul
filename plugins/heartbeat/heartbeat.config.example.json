{
  "$schema": "heartbeat-config-v1",
  "_README": "复制成 heartbeat.config.json 再改。这个文件是【模板】，不含任何个人路径与时区以外的东西。",
  "enabled": false,
  "options": {
    "idleThresholdMinutes": 15,
    "checkIntervalMinutes": 10,
    "schedule": {
      "mode": "cron",
      "cron": "0 6,12 * * *",
      "timezone": "Asia/Shanghai"
    },
    "catchUpMissed": false,
    "budget": {
      "maxRunsPerDay": 6,
      "maxTokensPerRun": null
    },
    "quietHours": null,
    "auditLevel": "normal",
    "logLevel": "full",
    "toolsAllowlist": [
      "memindex",
      "self",
      "daily",
      "doctor"
    ],
    "retry": {
      "max": 1,
      "delaySec": 5
    },
    "customSteps": [],
    "audit": {
      "tier": 1,
      "enabled": true,
      "humanPresentMinutes": 15,
      "_dirs_note": "写你的记忆库/书房目录。留空则用 DSH_HOME 推导出的默认值。",
      "sandboxDirs": [],
      "irreversible": [
        "delete",
        "push",
        "trade"
      ]
    }
  },
  "ignoreSessionIds": [],
  "_ignoreNote": "把「自己这边」的会话 id 片段填进来 —— 那些会话日志不算『他人活动』。"
}
